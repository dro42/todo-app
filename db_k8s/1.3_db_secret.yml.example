# NOT applied by `kubectl apply -f ./db_k8s` (only .yml/.yaml/.json are picked up).
# Never commit a real API key here: base64 is encoding, not encryption.
# Create the Secret directly instead:
#   kubectl create secret generic todo-db-secret -n dro42-dev \
#     --from-literal=apikey="$(grep '^CLOUDANT_APIKEY=' .env.local | cut -d= -f2)"
apiVersion: v1
kind: Secret
metadata:
  name: todo-db-secret
  namespace: dro42-dev
type: Opaque
data:
  apikey: <base64-encoded-apikey>
